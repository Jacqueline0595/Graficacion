{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:/msys64/msys2_shell.cmd",
            "args": [
                "-defterm",
                "-here",
                "-no-start",
                "-ucrt64",
                "-shell",
                "bash",
                "-lc",
                "g++ -fdiagnostics-color=always -g -O2 main.cpp cpp/*.cpp -I include -IC:/msys64/ucrt64/include -LC:/msys64/ucrt64/lib -DARMA_DONT_USE_WRAPPER -larmadillo -lopenblas -lglew32 -lglfw3 -lopengl32 -lglu32 -lgdi32 -luser32 -lkernel32 -o main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}