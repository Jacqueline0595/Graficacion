{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=never",
                "-g",
                "-O2",
                "main.cpp",
                "cpp/Animation.cpp",
                "cpp/Cannon.cpp",
                "cpp/Edge.cpp",
                "cpp/Face.cpp",
                "cpp/Model.cpp",
                "cpp/Obj.cpp",
                "cpp/OpenGL.cpp",
                "cpp/Ply.cpp",
                "cpp/Vertex.cpp",
                "-I", "include",
                "-IC:/msys64/ucrt64/include",
                "-LC:/msys64/ucrt64/lib",
                "-DARMA_DONT_USE_WRAPPER",
                "-larmadillo",
                "-lopenblas",
                "-lglfw3",
                "-lglew32",
                "-lglu32",
                "-lopengl32",
                "-lgdi32",
                "-luser32",
                "-lkernel32",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}